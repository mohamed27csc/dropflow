# Copiez ce fichier en .env.local (local) ou ajoutez ces variables dans Vercel › Settings › Environment Variables.
# `npm run doctor` indique ce qui manque. Sans les 3 variables Supabase, l'app reste en mode démo.

# ── Supabase (NEXT_PUBLIC_* est public par conception ; la clé service-role ne doit JAMAIS l'être)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Accès privé : SEULES ces adresses peuvent créer un compte et se connecter (séparées par des virgules)
OWNER_EMAILS=
# URL publique exacte du site (https://…). Obligatoire en production : liens des emails, contrôle d'origine.
NEXT_PUBLIC_SITE_URL=

# ── Secrets serveur (chacun : `openssl rand -hex 32`, tous DIFFÉRENTS entre eux et de toute clé Supabase/eBay)
ENCRYPTION_KEY=          # chiffre les jetons eBay et la clé CJ en base (AES-256-GCM, clés dérivées HKDF)
# ENCRYPTION_KEY_PREVIOUS=  # pendant une rotation : l'ancienne clé, pour relire les anciens chiffrés
CRON_SECRET=             # protège /api/cron/* (en-tête Authorization: Bearer, jamais dans l'URL)

# ── eBay Sell APIs (production)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=
# Webhook obligatoire « Marketplace account deletion » (developer.ebay.com › Alerts & Notifications)
EBAY_VERIFICATION_TOKEN= # 32 à 80 caractères
EBAY_WEBHOOK_ENDPOINT=   # https://<domaine>/api/webhooks/ebay/account-deletion

# ── Anti brute-force et limitation de débit (recommandé en production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=   # Cloudflare Turnstile (optionnel mais conseillé)
TURNSTILE_SECRET_KEY=

# ── IA (optionnel)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
